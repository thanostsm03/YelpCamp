<% layout("layouts/boilerplate")%>

    <div class="container">
        <div class="row">
            <!-- Back Button -->
            <div class="col-12 mb-3">
                <a href="/campgrounds/<%=campground._id%>" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Campground
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-success text-white">
                        <h3 class="mb-0"><i class="fas fa-edit"></i> Edit Campground</h3>
                    </div>
                    <div class="card-body p-4">
                        <form action="/campgrounds/<%=campground._id%>?_method=PUT" method="POST" novalidate
                            class="validated-form" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="title" class="form-label fw-semibold">Title</label>
                                    <input type="text" id="title" name="campground[title]"
                                        class="form-control form-control-lg" value="<%=campground.title%>"
                                        placeholder="Enter campground name" required>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="location" class="form-label fw-semibold">Location</label>
                                    <input type="text" id="location" name="campground[location]"
                                        class="form-control form-control-lg" value="<%=campground.location%>"
                                        placeholder="Enter location" required>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="price" class="form-label fw-semibold">Price per Night</label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-success text-white">$</span>
                                        <input type="number" class="form-control" id="price" placeholder="0.00"
                                            name="campground[price]" value="<%=campground.price%>" min="0" step="0.01"
                                            required>
                                    </div>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="formFileMultiple" class="form-label fw-semibold">Add More Images</label>
                                    <input class="form-control form-control-lg" type="file" id="formFileMultiple"
                                        name="image" multiple accept="image/*">
                                    <div class="form-text">Select multiple images to add to your campground</div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="description" class="form-label fw-semibold">Description</label>
                                <textarea id="description" name="campground[description]" class="form-control" rows="4"
                                    placeholder="Describe your campground..."
                                    required><%=campground.description%></textarea>
                                <div class="valid-feedback">Looks good!</div>
                            </div>

                            <% if(campground.images.length> 0) { %>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-danger">
                                        <i class="fas fa-trash"></i> Delete Existing Images
                                    </label>
                                    <p class="text-muted small mb-3">Click on images or checkboxes to select for
                                        deletion</p>
                                    <div class="row g-3">
                                        <% campground.images.forEach(function(img, i) { %>
                                            <div class="col-sm-6 col-md-4">
                                                <div class="card border-0 shadow-sm image-delete-card"
                                                    style="cursor: pointer;"
                                                    onclick="toggleImageDelete('image-<%=i%>')">
                                                    <img src="<%=img.thumbnail%>" alt="Campground image"
                                                        class="card-img-top"
                                                        style="height: 150px; object-fit: cover; transition: opacity 0.3s;">
                                                    <div class="card-body p-2 text-center">
                                                        <div class="form-check">
                                                            <input type="checkbox" name="deleteImages[]"
                                                                id="image-<%=i%>" class="form-check-input"
                                                                value="<%=img.filename%>"
                                                                onchange="updateImageStyle('image-<%=i%>')">
                                                            <label for="image-<%=i%>"
                                                                class="form-check-label text-danger fw-semibold">
                                                                <i class="fas fa-trash me-1"></i>Delete
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>

                                    <script>
                                        function toggleImageDelete(checkboxId) {
                                            const checkbox = document.getElementById(checkboxId);
                                            checkbox.checked = !checkbox.checked;
                                            updateImageStyle(checkboxId);
                                        }

                                        function updateImageStyle(checkboxId) {
                                            const checkbox = document.getElementById(checkboxId);
                                            const card = checkbox.closest('.image-delete-card');
                                            const img = card.querySelector('img');

                                            if (checkbox.checked) {
                                                img.style.opacity = '0.5';
                                                img.style.filter = 'grayscale(100%)';
                                                card.style.borderColor = '#dc3545';
                                                card.style.borderWidth = '2px';
                                                card.style.borderStyle = 'solid';
                                            } else {
                                                img.style.opacity = '1';
                                                img.style.filter = 'none';
                                                card.style.border = 'none';
                                            }
                                        }
                                    </script>
                                </div>
                                <% } %>

                                    <div class="d-flex gap-3 justify-content-end">
                                        <a href="/campgrounds/<%=campground._id%>"
                                            class="btn btn-outline-secondary btn-lg">
                                            <i class="fas fa-times"></i> Cancel
                                        </a>
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="fas fa-save"></i> Update Campground
                                        </button>
                                    </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>