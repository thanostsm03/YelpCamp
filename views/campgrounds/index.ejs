<% layout("layouts/boilerplate")%>

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="display-4 fw-bold text-success">Discover Campgrounds</h1>
                    <a href="/campgrounds/new" class="btn btn-success btn-lg">
                        <i class="fas fa-plus"></i> Add New Campground
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <% for(let campground of campgrounds) { %>
                <div class="col-lg-6 col-xl-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <div class="position-relative">
                            <img class="card-img-top"
                                src="<%=campground.images.length ? campground.images[0].url : 'https://via.placeholder.com/400x250?text=No+Image'%>"
                                alt="<%=campground.title%>" style="height: 250px; object-fit: cover;">
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-success fs-6">$<%=campground.price%>/night</span>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold mb-2">
                                <%=campground.title%>
                            </h5>
                            <p class="card-text text-muted mb-2">
                                <i class="fas fa-map-marker-alt text-success"></i>
                                <%=campground.location%>
                            </p>
                            <p class="card-text flex-grow-1">
                                <%=campground.description.substring(0, 100)%>...
                            </p>
                            <div class="mt-auto">
                                <a href="/campgrounds/<%=campground._id%>" class="btn btn-outline-success w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>
    </div>