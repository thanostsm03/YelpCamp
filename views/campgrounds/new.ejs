<% layout("layouts/boilerplate")%>

    <div class="container">
        <div class="row">
            <!-- Back Button -->
            <div class="col-12 mb-3">
                <a href="/campgrounds" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Campgrounds
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-success text-white">
                        <h3 class="mb-0"><i class="fas fa-plus"></i> Create New Campground</h3>
                    </div>
                    <div class="card-body p-4">
                        <form action="/campgrounds" method="POST" novalidate class="validated-form"
                            enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="title" class="form-label fw-semibold">Title</label>
                                    <input type="text" id="title" name="campground[title]"
                                        class="form-control form-control-lg" placeholder="Enter campground name"
                                        required>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="location" class="form-label fw-semibold">Location</label>
                                    <input type="text" id="location" name="campground[location]"
                                        class="form-control form-control-lg" placeholder="Enter location" required>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="price" class="form-label fw-semibold">Price per Night</label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-success text-white">$</span>
                                        <input type="number" class="form-control" id="price" placeholder="0.00"
                                            name="campground[price]" min="0" step="0.01" required>
                                    </div>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="formFileMultiple" class="form-label fw-semibold">Images</label>
                                    <input class="form-control form-control-lg" type="file" id="formFileMultiple"
                                        name="image" multiple accept="image/*" required>
                                    <div class="form-text">Select multiple images for your campground</div>
                                    <div class="valid-feedback">Looks good!</div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="description" class="form-label fw-semibold">Description</label>
                                <textarea id="description" name="campground[description]" class="form-control" rows="4"
                                    placeholder="Describe your campground..." required></textarea>
                                <div class="valid-feedback">Looks good!</div>
                            </div>

                            <div class="d-flex gap-3 justify-content-end">
                                <a href="/campgrounds" class="btn btn-outline-secondary btn-lg">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-plus"></i> Create Campground
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>