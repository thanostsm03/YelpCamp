<%layout ("layouts/boilerplate")%>

    <div class="container">
        <div class="row justify-content-center" style="min-height: 60vh;">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mt-5">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="fas fa-exclamation-triangle text-warning" style="font-size: 4rem;"></i>
                        </div>
                        <h1 class="card-title text-danger fw-bold mb-3">Oops! Something went wrong</h1>
                        <h4 class="text-muted mb-4">
                            <%=err.message%>
                        </h4>

                        <div class="d-flex gap-3 justify-content-center">
                            <a href="/campgrounds" class="btn btn-success btn-lg">
                                <i class="fas fa-mountain me-2"></i>Browse Campgrounds
                            </a>
                            <a href="/" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-home me-2"></i>Go Home
                            </a>
                        </div>

                        <% if (process.env.NODE_ENV !=='production' ) { %>
                            <div class="mt-5">
                                <details class="text-start">
                                    <summary class="btn btn-outline-danger btn-sm mb-3">
                                        <i class="fas fa-bug me-1"></i>Show Error Details (Development)
                                    </summary>
                                    <div class="alert alert-danger">
                                        <pre class="mb-0"
                                            style="font-size: 0.8rem; white-space: pre-wrap;"><%=err.stack%></pre>
                                    </div>
                                </details>
                            </div>
                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>