<% layout("layouts/boilerplate")%>

    <div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="row w-100">
            <div class="col-md-6 offset-md-3 col-xl-4 offset-xl-4">
                <div class="card shadow-lg border-0">
                    <img src="https://images.unsplash.com/photo-1631635589499-afd87d52bf64?q=80&w=871&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
                        alt="Camping scene" class="card-img-top" style="height: 200px; object-fit: cover;">
                    <div class="card-body p-4">
                        <h4 class="card-title text-center mb-4 fw-bold text-success">Welcome Back</h4>
                        <form action="/login" method="POST" class="validated-form" novalidate>
                            <div class="mb-3">
                                <label for="username" class="form-label fw-semibold">Username</label>
                                <input type="text" class="form-control form-control-lg" id="username" name="username"
                                    placeholder="Enter your username" autofocus required>
                                <div class="valid-feedback">Looks good!</div>
                            </div>
                            <div class="mb-4">
                                <label for="password" class="form-label fw-semibold">Password</label>
                                <input type="password" class="form-control form-control-lg" id="password"
                                    name="password" placeholder="Enter your password" required>
                                <div class="valid-feedback">Looks good!</div>
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-success btn-lg fw-semibold">Sign In</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>